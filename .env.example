# BHUSHAKTI AI — Environment Configuration Example

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BHUSHAKTI AI"
NEXT_PUBLIC_APP_VERSION="1.0.0-prototype"

# Supabase Configuration (Optional for standalone demo, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-instance.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-key-do-not-expose"

# AI & Remote Sensing Vision Integration (Optional Adapter)
VISION_MODEL_PROVIDER="simulated" # Options: 'simulated' | 'openai' | 'gemini' | 'custom'
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Map Tiles & GIS Configuration (Default uses OpenStreetMap / CARTO dark tiles)
NEXT_PUBLIC_MAP_STYLE_LIGHT="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_MAP_STYLE_DARK="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"

# Alert Dispatch Channels (SMS / Email Adapter Settings)
ALERT_SMS_PROVIDER="mock" # Options: 'mock' | 'twilio' | 'gov_sms_gateway'
ALERT_EMAIL_PROVIDER="mock" # Options: 'mock' | 'resend' | 'smtp'
